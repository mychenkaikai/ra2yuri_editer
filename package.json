{
    "name": "ra2yr-editor",
    "version": "1.0.0",
    "description": "红警2尤里复仇配置编辑器",
    "main": "electron/dist/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "electron:tsc": "tsc -p tsconfig.electron.json",
        "electron:dev": "concurrently \"npm run dev\" \"npm run electron:tsc\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
        "electron:build": "npm run prepare && npm run electron:tsc && vue-tsc && vite build && electron-builder",
        "prepare": "node scripts/copyTemplates.js"
    },
    "dependencies": {
        "element-plus": "^2.3.0",
        "vue": "^3.3.0",
        "vue-router": "^4.4.5",
        "vuex": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@vitejs/plugin-vue": "^4.0.0",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^25.0.0",
        "electron-builder": "^24.0.0",
        "typescript": "^5.0.0",
        "vite": "^4.0.0",
        "vue-tsc": "^1.0.0",
        "wait-on": "^7.2.0"
    }
}
