{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "outDir": "electron/dist",
      "rootDir": "electron/src",
      "strict": true,
      "sourceMap": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
    },
    "include": ["electron/src/**/*"],
    "exclude": ["node_modules", "src"]
  }